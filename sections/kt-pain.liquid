{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-pain color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-pain__grid">
      <div class="kt-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="kt-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="kt-lead-text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary" style="margin-top: 3.2rem;">
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ol class="kt-pain__list">
          {%- for block in section.blocks -%}
            <li class="kt-pain__item kt-reveal" {{ block.shopify_attributes }}>
              <div>
                <p class="kt-pain__q">{{ block.settings.question }}</p>
                {%- if block.settings.answer != blank -%}
                  <div class="kt-pain__a">{{ block.settings.answer }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Znáš to?",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Znáš to?" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Kolena to všechno nesou" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Tlačítko – text" },
    { "type": "url", "id": "button_link", "label": "Tlačítko – odkaz" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Situace",
      "settings": [
        { "type": "text", "id": "question", "label": "Situace", "default": "Koleno se ozve po tréninku" },
        { "type": "richtext", "id": "answer", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KT – Znáš to?",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
