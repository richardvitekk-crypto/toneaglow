    "faq": {
      "type": "kt-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Pomůže mi, když mě bolí koleno?",
            "answer": "<p>Bandáž dává kolenu kompresi a oporu. Díky tomu koleno víc cítíš a máš pocit, že drží jistěji. Neslibujeme ale, že bolest zmizí – bandáž není lék. Když tě koleno bolí déle než pár dní, zajdi za doktorem.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Můžu v ní hrát zápas?",
            "answer": "<p>Ano. Pravidla fotbalu povolují měkké ochranné pomůcky, které nejsou nebezpečné pro tebe ani pro soupeře. Poslední slovo má vždy rozhodčí.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Jak pevně ji utáhnout?",
            "answer": "<p>Pevně, ale ne na doraz. Musíš v ní normálně ohnout koleno a noha nesmí brnět, modřat ani otékat. Když něco z toho cítíš, povol suchý zip.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Je cena za kus, nebo za pár?",
            "answer": "<p>Za jeden kus, tedy na jedno koleno. Na obě kolena vyber 2 kusy za 790 Kč a ušetříš 390 Kč.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Jak dlouho trvá doručení?",
            "answer": "<p>Do 14 dnů od objednávky. Cenu dopravy uvidíš v pokladně, od 1 500 Kč je zdarma. Po odeslání ti přijde odkaz na sledování zásilky.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Můžu bandáž vrátit?",
            "answer": "<p>Ano. Na vrácení máš 14 dní od převzetí, bez udání důvodu. Stačí nám napsat a bandáž poslat zpět čistou a nepoškozenou. Podrobnosti najdeš na stránce <a href=\"/pages/doprava-a-vraceni\">Doprava a vrácení</a>.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Sedí na levé i pravé koleno?",
            "answer": "<p>Ano, bandáž je stejná pro obě kolena.</p>"
          }
        }
      },
