{%- comment -%}
  Videa z hřiště (formát na výšku 9:16). Sekce se zobrazí, až přidáš aspoň jedno video.
{%- endcomment -%}
{%- render 'kt-section-padding', section: section -%}

{%- liquid
  assign has_media = false
  for block in section.blocks
    if block.settings.video != blank or block.settings.image != blank
      assign has_media = true
    endif
  endfor
-%}

{%- if has_media -%}
  <div class="kt-section kt-videos color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="kt-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="kt-heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="kt-lead-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      <div class="kt-videos__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.video != blank or block.settings.image != blank -%}
            <div class="kt-video" {{ block.shopify_attributes }}>
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: false,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    controls: false,
                    preload: 'metadata',
                    image_size: '600x'
                }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="kt-video__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "KT – Videa z hřiště",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Z hřiště" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Vyzkoušeno na trávě" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (na výšku)" },
        { "type": "image_picker", "id": "image", "label": "Obrázek (když nemáš video)" },
        { "type": "text", "id": "caption", "label": "Popisek" }
      ]
    }
  ],
  "presets": [{ "name": "KT – Videa z hřiště" }]
}
{% endschema %}
