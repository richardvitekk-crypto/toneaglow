{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-reveal{% if section.settings.center %} kt-center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="kt-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="kt-benefits__grid kt-benefits__grid--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          <div class="kt-benefit kt-reveal" {{ block.shopify_attributes }}>
            {%- if section.settings.show_numbers -%}
              <span class="kt-benefit__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if block.settings.icon != 'none' -%}
              {%- render 'kt-icon', name: block.settings.icon, class: 'kt-benefit__icon' -%}
            {%- endif -%}
            <h3 class="kt-benefit__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="kt-benefit__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.safety_show and section.settings.safety_title != blank -%}
      {{ 'kt-fyzio.css' | asset_url | stylesheet_tag }}
      <div id="pro-rodice" class="kt-safety kt-reveal">
        <div class="kt-safety__icon">{%- render 'kt-icon', name: 'shield', class: 'kt-safety__svg' -%}</div>
        <div class="kt-safety__body">
          {%- if section.settings.safety_eyebrow != blank -%}
            <p class="kt-safety__eyebrow">{{ section.settings.safety_eyebrow }}</p>
          {%- endif -%}
          <h3 class="kt-safety__title">{{ section.settings.safety_title }}</h3>
          {%- if section.settings.safety_text != blank -%}
            <div class="kt-safety__text">{{ section.settings.safety_text }}</div>
          {%- endif -%}
          {%- if section.settings.safety_doctor != blank -%}
            <div class="kt-safety__doctor">
              {%- render 'kt-icon', name: 'medical', class: 'kt-safety__doctor-icon' -%}
              <div>{{ section.settings.safety_doctor }}</div>
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.safety_cta_label != blank -%}
          <a class="kt-safety__cta" data-kt-physio-open href="{{ section.settings.safety_cta_link | default: '#fyzioterapeut' | escape }}">
            {%- if section.settings.safety_cta_text != blank -%}
              <span class="kt-safety__cta-text">{{ section.settings.safety_cta_text }}</span>
            {%- endif -%}
            <span class="kt-safety__cta-label">
              {{- section.settings.safety_cta_label -}}
              {%- render 'kt-icon', name: 'arrow', class: 'kt-safety__cta-icon' -%}
            </span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Výhody",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Proč KNEETECH" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Není to jen kus látky" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "center", "label": "Zarovnat na střed", "default": false },
    { "type": "checkbox", "id": "show_numbers", "label": "Zobrazit čísla", "default": true },
    {
      "type": "select",
      "id": "columns",
      "label": "Sloupce na počítači",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "header", "content": "Karta Bezpečné nošení" },
    { "type": "checkbox", "id": "safety_show", "label": "Zobrazit kartu pod výhodami", "default": false },
    { "type": "text", "id": "safety_eyebrow", "label": "Malý nadpis karty", "default": "Pro hráče i rodiče" },
    { "type": "text", "id": "safety_title", "label": "Nadpis karty", "default": "Bezpečné nošení" },
    { "type": "richtext", "id": "safety_text", "label": "Text karty" },
    { "type": "richtext", "id": "safety_doctor", "label": "Kdy k lékaři (zvýrazněný řádek)" },
    { "type": "text", "id": "safety_cta_text", "label": "Výzva k fyzioterapeutovi", "default": "Chceš doporučit fyzioterapeuta?" },
    { "type": "text", "id": "safety_cta_label", "label": "Text odkazu", "default": "Doporučíme ti ho" },
    { "type": "text", "id": "safety_cta_link", "label": "Odkaz", "default": "#fyzioterapeut", "info": "Kotva sekce KT – Fyzioterapeut." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Výhoda",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikona",
          "options": [
            { "value": "none", "label": "Žádná" },
            { "value": "compression", "label": "Komprese" },
            { "value": "velcro", "label": "Suchý zip" },
            { "value": "grip", "label": "Protiskluz" },
            { "value": "feather", "label": "Lehkost" },
            { "value": "air", "label": "Prodyšnost" },
            { "value": "knee", "label": "Koleno" },
            { "value": "ball", "label": "Míč" },
            { "value": "truck", "label": "Doprava" },
            { "value": "lock", "label": "Zámek" },
            { "value": "chat", "label": "Zpráva" }
          ],
          "default": "compression"
        },
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Komprese" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Obepne koleno ze všech stran.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KT – Výhody",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "compression", "title": "Komprese" } },
        { "type": "benefit", "settings": { "icon": "velcro", "title": "Suchý zip" } },
        { "type": "benefit", "settings": { "icon": "grip", "title": "Protiskluz" } },
        { "type": "benefit", "settings": { "icon": "feather", "title": "Lehká" } }
      ]
    }
  ]
}
{% endschema %}
