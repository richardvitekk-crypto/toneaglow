{%- comment -%}
  Tabulka velikostí na 1 kliknutí – otevře se v okně přímo u výběru velikosti,
  zákazník neodchází ze stránky. Bez JS odkaz vede na stránku Velikosti.
  Accepts:
  - sizes {String} – 'S:30–33 cm:mladší a štíhlejší hráči|M:33–36 cm:…' (poznámka nepovinná)
  - label {String} – text odkazu
  - page {String}  – odkaz na celou stránku (výchozí /pages/velikosti)
  - calc {Boolean} – false skryje kalkulačku velikosti (výchozí zobrazená)

  Kalkulačka: zákazník zadá obvod kolena v cm, ukáže se velikost a sama se vybere
  ve výběru „Velikost“. Rozsahy se berou ze sizes (např. „30–33 cm“), nic natvrdo.
  Na hranici dvou velikostí vybere menší (pevnější stisk), stejně jako radí tabulka.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url | append: '/' | replace: '//', '/'
  assign default_label = 'kneetech.size.link' | t
  assign default_page = root | append: 'pages/velikosti'
  assign default_sizes = 'kneetech.size.list' | t
  assign label = label | default: default_label
  assign page = page | default: default_page
  assign sizes = sizes | default: default_sizes
  assign dialog_id = 'kt-size-dialog'
  assign rows = sizes | split: '|'
  assign contact_url = root | append: 'pages/contact'
-%}
{{ 'kt-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kt-landing.js' | asset_url }}" defer="defer"></script>

<a class="kt-size-link kt-size-open" href="{{ page }}" data-kt-size-open aria-controls="{{ dialog_id }}" aria-haspopup="dialog">
  {%- render 'kt-icon', name: 'ruler' -%}
  {{ label }}
</a>

{%- unless calc == false -%}
  {{ 'kt-size-calc.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kt-size-calc.js' | asset_url }}" defer="defer"></script>
  {%- capture calc_ranges -%}
    {%- for row in rows -%}
      {%- liquid
        assign parts = row | split: ':'
        assign range = parts[1] | remove: 'cm' | replace: '-', '–' | split: '–'
        assign low = range[0] | strip | replace: ',', '.'
        assign high = range[1] | strip | replace: ',', '.'
      -%}
      {%- unless forloop.first %}|{% endunless -%}
      {{- parts[0] | strip }};{{ low }};{{ high -}}
    {%- endfor -%}
  {%- endcapture -%}
  <kt-size-calc
    class="kt-calc"
    data-ranges="{{ calc_ranges | escape }}"
    data-contact="{{ contact_url }}"
    data-t-invalid="{{ 'kneetech.size.calc_invalid' | t | escape }}"
    data-t-below="{{ 'kneetech.size.calc_below_html' | t | escape }}"
    data-t-above="{{ 'kneetech.size.calc_above_html' | t | escape }}"
    data-t-missing="{{ 'kneetech.size.calc_missing_html' | t | escape }}"
    data-t-done="{{ 'kneetech.size.calc_done' | t | escape }}"
    data-t-edge="{{ 'kneetech.size.calc_edge' | t | escape }}"
    data-t-range="{{ 'kneetech.size.calc_range' | t | escape }}"
  >
    <label class="kt-calc__label" for="KtCalc-{{ section.id }}">{{ 'kneetech.size.calc_label' | t }}</label>
    <div class="kt-calc__row">
      <div class="kt-calc__field">
        <input
          id="KtCalc-{{ section.id }}"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          maxlength="5"
          placeholder="{{ 'kneetech.size.calc_placeholder' | t | escape }}"
          aria-describedby="KtCalcOut-{{ section.id }}"
        >
        <span aria-hidden="true">cm</span>
      </div>
      <p class="kt-calc__out" id="KtCalcOut-{{ section.id }}" aria-live="polite">{{ 'kneetech.size.calc_hint' | t }}</p>
    </div>
  </kt-size-calc>
{%- endunless -%}

<dialog class="kt-size-dialog color-scheme-1" id="{{ dialog_id }}" aria-labelledby="{{ dialog_id }}-title">
  <div class="kt-size-dialog__box">
    <button type="button" class="kt-size-dialog__close" data-kt-size-close aria-label="{{ 'kneetech.size.close' | t | escape }}">
      {%- render 'kt-icon', name: 'cross' -%}
    </button>
    <p class="kt-size-dialog__title" id="{{ dialog_id }}-title">{{ 'kneetech.size.title' | t }}</p>
    <ol class="kt-size-dialog__steps">
      <li>{{ 'kneetech.size.step1' | t }}</li>
      <li>{{ 'kneetech.size.step2' | t }}</li>
      <li>{{ 'kneetech.size.step3' | t }}</li>
    </ol>
    <table class="kt-size-dialog__table">
      <thead>
        <tr><th scope="col">{{ 'kneetech.size.col_size' | t }}</th><th scope="col">{{ 'kneetech.size.col_circumference' | t }}</th></tr>
      </thead>
      <tbody>
        {%- for row in rows -%}
          {%- assign parts = row | split: ':' -%}
          <tr>
            <th scope="row">{{ parts[0] }}</th>
            <td>
              {{- parts[1] -}}
              {%- if parts[2] != blank -%}<small>{{ parts[2] }}</small>{%- endif -%}
            </td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    <p class="kt-size-dialog__tip">
      {{ 'kneetech.size.tip' | t }}
    </p>
    <a class="kt-size-dialog__more" href="{{ page }}">{{ 'kneetech.size.more' | t }}</a>
  </div>
</dialog>
