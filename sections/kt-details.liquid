{%- comment -%}
  Vše o bandáži – rozbalovací řádky (nasazení, materiál, doprava, bezpečnost), „Platí rodiče?“
  a údaje o výrobci. Stojí pod produktem přes celou šířku, aby byl nákupní sloupec vpravo krátký
  a vedle fotek nezůstávalo prázdné místo. Texty řádků jsou v jazykových souborech (kneetech.tabs.*).
{%- endcomment -%}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'kt-chips.css' | asset_url | stylesheet_tag }}
{%- render 'kt-section-padding', section: section -%}

{%- liquid
  assign kt_p = section.settings.product
  if kt_p == blank and product != blank
    assign kt_p = product
  endif
  if kt_p == blank
    assign kt_p = all_products['kneetech-bandaz-na-koleno']
  endif
  assign kt_root = routes.root_url | append: '/' | replace: '//', '/'
-%}

<div class="kt-section kt-details color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-details__grid">
      <div class="kt-details__main">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kt-heading kt-details__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="kt-details__acc">
          {%- if section.settings.show_fit -%}
            {%- capture c -%}{{ 'kneetech.tabs.fit_html' | t | replace: '[root]', kt_root }}{%- endcapture -%}
            {%- assign h = 'kneetech.tabs.fit_title' | t -%}
            {% render 'kt-accordion', id: 'fit', icon: 'check_mark', heading: h, content: c %}
          {%- endif -%}
          {%- if section.settings.show_material -%}
            {%- capture c -%}{{ 'kneetech.tabs.material_html' | t | replace: '[root]', kt_root }}{%- endcapture -%}
            {%- assign h = 'kneetech.tabs.material_title' | t -%}
            {% render 'kt-accordion', id: 'material', icon: 'washing', heading: h, content: c %}
          {%- endif -%}
          {%- if section.settings.show_shipping -%}
            {%- capture c -%}{{ 'kneetech.tabs.shipping_html' | t | replace: '[root]', kt_root }}{%- endcapture -%}
            {%- assign h = 'kneetech.tabs.shipping_title' | t -%}
            {% render 'kt-accordion', id: 'shipping', icon: 'truck', heading: h, content: c %}
          {%- endif -%}
          {%- if section.settings.show_safety -%}
            {%- capture c -%}{{ 'kneetech.tabs.safety_html' | t | replace: '[root]', kt_root }}{%- endcapture -%}
            {%- assign h = 'kneetech.tabs.safety_title' | t -%}
            {% render 'kt-accordion', id: 'safety', icon: 'check_mark', heading: h, content: c %}
          {%- endif -%}
        </div>
      </div>

      {%- liquid
        assign show_side = false
        if section.settings.show_share and kt_p != blank
          assign show_side = true
        endif
        if section.settings.show_manufacturer and kt_p.metafields.custom.vyrobce != blank
          assign show_side = true
        endif
      -%}
      {%- if show_side -%}
        <aside class="kt-details__side">
          {%- if section.settings.show_share and kt_p != blank -%}
            {% render 'kt-share', product: kt_p %}
          {%- endif -%}
          {%- if section.settings.show_manufacturer and kt_p.metafields.custom.vyrobce != blank -%}
            <p class="kt-note kt-details__note">{{ kt_p.metafields.custom.vyrobce | newline_to_br }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Vše o bandáži",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt", "info": "Prázdné = produkt na stránce, jinak KNEETECH bandáž." },
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Detaily" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Vše o bandáži" },
    { "type": "checkbox", "id": "show_fit", "label": "Jak ji nasadit", "default": true },
    { "type": "checkbox", "id": "show_material", "label": "Materiál a péče", "default": true },
    { "type": "checkbox", "id": "show_shipping", "label": "Doprava a vrácení", "default": true },
    { "type": "checkbox", "id": "show_safety", "label": "Bezpečnost", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Box „Platí rodiče?“", "default": true },
    { "type": "checkbox", "id": "show_manufacturer", "label": "Údaje o výrobci", "default": true },
    { "type": "paragraph", "content": "Texty řádků upravíš v Nastavení motivu → Upravit výchozí obsah motivu → hledej „kneetech.tabs“." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 72 }
  ],
  "presets": [{ "name": "KT – Vše o bandáži" }]
}
{% endschema %}
