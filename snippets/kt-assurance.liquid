{%- comment -%}
  Pravdivé informace pod tlačítkem „Přidat do košíku“: doručení, vrácení, platby.
  Nahrazuje původní ikonky (vrácení / platba / poradíme).
  Accepts:
  - delivery {String}      – např. 'Doručení do 14 dnů'
  - delivery_sub {String}  – např. 'Se sledováním zásilky'
  - returns {String}       – např. '14 dní na vrácení'
  - returns_sub {String}   – např. 'Bez udání důvodu'
  - link {String}          – odkaz na podrobnosti (výchozí /pages/doprava-a-vraceni)
  - brand {String}         – řádek se značkou (výchozí „Česká značka z Brna“, '-' skryje)
  - payments {Boolean}     – false skryje ikony plateb

  Ikony plateb se berou ze skutečně zapnutých plateb v Shopify (shop.enabled_payment_types),
  takže ukazují jen to, co jde opravdu zaplatit.
{%- endcomment -%}
{{ 'kt-landing.css' | asset_url | stylesheet_tag }}
{{ 'kt-popis.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign root = routes.root_url | append: '/' | replace: '//', '/'
  assign d_delivery = 'kneetech.assure.delivery' | t
  assign d_delivery_sub = 'kneetech.assure.delivery_sub' | t
  assign d_returns = 'kneetech.assure.returns' | t
  assign d_returns_sub = 'kneetech.assure.returns_sub' | t
  assign d_link = root | append: 'pages/doprava-a-vraceni'
  assign d_brand = 'kneetech.assure.brand' | t
  assign delivery = delivery | default: d_delivery
  assign delivery_sub = delivery_sub | default: d_delivery_sub
  assign returns = returns | default: d_returns
  assign returns_sub = returns_sub | default: d_returns_sub
  assign link = link | default: d_link
  assign brand = brand | default: d_brand
-%}
<div class="kt-assure">
  <ul class="kt-assure__list">
    <li>
      {% render 'kt-icon', name: 'truck', class: 'kt-assure__icon' %}
      <span><strong>{{ delivery }}</strong>{% if delivery_sub != blank %}<small>{{ delivery_sub }}</small>{% endif %}</span>
    </li>
    <li>
      {% render 'kt-icon', name: 'return', class: 'kt-assure__icon' %}
      <span><strong>{{ returns }}</strong>{% if returns_sub != blank %}<small>{{ returns_sub }}</small>{% endif %}</span>
    </li>
  </ul>

  <div class="kt-trust">
    {%- if brand != '-' -%}
      <p class="kt-trust__brand">
        <svg class="kt-trust__flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="10" fill="#fff"/><rect y="10" width="30" height="10" fill="#d7141a"/><path d="M0 0 15 10 0 20Z" fill="#11457e"/></svg>
        {{ brand }}
      </p>
    {%- endif -%}
    <p class="kt-trust__secure">
      {%- render 'kt-icon', name: 'lock', class: 'kt-trust__lock' -%}
      {{ 'kneetech.assure.secure' | t }}
    </p>
    {%- unless payments == false -%}
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="kt-trust__pay" role="list" aria-label="{{ 'kneetech.assure.payments' | t | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'kt-trust__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endunless -%}
  </div>

  <a class="kt-assure__link" href="{{ link }}">{{ 'kneetech.assure.link' | t }}</a>
</div>
