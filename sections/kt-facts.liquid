{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-facts color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-center kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="kt-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="kt-facts__grid">
        {%- for block in section.blocks -%}
          <div class="kt-fact kt-reveal" {{ block.shopify_attributes }}>
            <p class="kt-fact__big">{{ block.settings.big }}</p>
            <div class="kt-fact__text">{{ block.settings.text }}</div>
            {%- if block.settings.source != blank -%}
              <p class="kt-fact__source">{{ block.settings.source }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.disclaimer != blank -%}
      <div class="kt-disclaimer">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Fakta",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Jak to funguje" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Žádná magie. Fakta." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "disclaimer", "label": "Upozornění pod fakty" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 88 }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakt",
      "settings": [
        { "type": "text", "id": "big", "label": "Velký text", "default": "Komprese" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Popis faktu.</p>" },
        { "type": "text", "id": "source", "label": "Zdroj" }
      ]
    }
  ],
  "presets": [
    { "name": "KT – Fakta", "blocks": [{ "type": "fact" }, { "type": "fact" }, { "type": "fact" }] }
  ]
}
{% endschema %}
