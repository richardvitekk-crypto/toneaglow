{%- comment -%}
  Hřištní pruh s hlavním sdělením nad nákupním boxem (úvod i produkt).
  Na mobilu je první, co návštěvník z TikToku/Instagramu uvidí – hned pod ním
  je fotka produktu a výběr balení. Záměrně krátký, aby netlačil nákup dolů.
  Štítky mají volitelnou ikonu (místo tečky) a odkaz (např. #recenze-z-terenu).
{%- endcomment -%}
{{ 'kt-landing.css' | asset_url | stylesheet_tag }}
{{ 'kt-chips.css' | asset_url | stylesheet_tag }}
{%- comment -%} posuvník galerie produktu – na úvodu ho sekce „Vybraný produkt“ sama nenačítá {%- endcomment -%}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

<div class="kt-hl color-{{ section.settings.color_scheme }} gradient">
  <div class="kt-hl__pitch" aria-hidden="true"><span></span></div>
  <div class="page-width kt-hl__inner">
    {%- assign kicker = section.settings.kicker | default: 'Kompresní bandáž na koleno pro fotbalisty' -%}
    {%- if kicker != '-' -%}
      {%- if template.name == 'index' -%}
        <h1 class="kt-hl__kicker">{{ kicker }}</h1>
      {%- else -%}
        <p class="kt-hl__kicker">{{ kicker }}</p>
      {%- endif -%}
    {%- endif -%}
    <p class="kt-hl__title">
      {{- section.settings.heading -}}
      {%- if section.settings.heading_accent != blank -%}
        {{ ' ' }}<em>{{ section.settings.heading_accent }}</em>
      {%- endif -%}
    </p>
    {%- if section.blocks.size > 0 -%}
      <ul class="kt-hl__chips">
        {%- for block in section.blocks -%}
          {%- liquid
            assign chip_icon = block.settings.icon | default: 'none'
            assign chip_link = block.settings.link | strip
            assign chip_class = ''
            if chip_icon != 'none'
              assign chip_class = 'kt-hl__chip--icon'
            endif
            if chip_link != blank
              assign chip_class = chip_class | append: ' kt-hl__chip--link'
            endif
          -%}
          <li class="{{ chip_class | strip }}" {{ block.shopify_attributes }}>
            {%- if chip_link != blank -%}<a href="{{ chip_link | escape }}">{%- endif -%}
            {%- if chip_icon != 'none' -%}
              {%- render 'kt-icon', name: chip_icon, class: 'kt-hl__chip-icon' -%}
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
            {%- if chip_link != blank -%}
              {%- render 'kt-icon', name: 'arrow', class: 'kt-hl__chip-arrow' -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Hlavní sdělení",
  "tag": "section",
  "class": "section kt-hl-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Malý text nad nadpisem", "info": "Napiš jen pomlčku (-), když ho nechceš.", "default": "Kompresní bandáž na koleno pro fotbalisty" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Hraj naplno." },
    { "type": "text", "id": "heading_accent", "label": "Nadpis – zvýrazněná část", "default": "Jistota v každé kličce." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Štítek",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Doručení do 14 dnů" },
        {
          "type": "select",
          "id": "icon",
          "label": "Ikona",
          "default": "none",
          "options": [
            { "value": "none", "label": "Žádná (tečka)" },
            { "value": "truck", "label": "Auto / doprava" },
            { "value": "return-circle", "label": "Kolečko / vrácení" },
            { "value": "ball", "label": "Míč" },
            { "value": "shield", "label": "Štít" },
            { "value": "trophy", "label": "Pohár" },
            { "value": "check", "label": "Fajfka" }
          ]
        },
        { "type": "text", "id": "link", "label": "Odkaz (nepovinné)", "info": "Např. #recenze-z-terenu (sjede na recenze hráčů) nebo /pages/velikosti." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KT – Hlavní sdělení",
      "blocks": [
        { "type": "chip", "settings": { "text": "Doručení do 14 dnů", "icon": "truck" } },
        { "type": "chip", "settings": { "text": "14 dní na vrácení", "icon": "return-circle" } },
        { "type": "chip", "settings": { "text": "Vyzkoušeno v profi mládežích ČR", "icon": "ball", "link": "#recenze-z-terenu" } }
      ]
    }
  ]
}
{% endschema %}
