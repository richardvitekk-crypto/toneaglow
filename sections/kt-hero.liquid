{%- render 'kt-section-padding', section: section -%}

{%- liquid
  assign hero_product = section.settings.product
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product != blank
    assign hero_image = hero_product.featured_media.preview_image
  endif
  assign primary_link = section.settings.button_link
  if primary_link == blank and hero_product != blank
    assign primary_link = hero_product.url
  endif
-%}

<div
  class="kt-section kt-hero kt-hero--bg-{{ section.settings.background }} color-{{ section.settings.color_scheme }} gradient"
  style="--kt-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  {%- if section.settings.background != 'none' -%}
    <div class="kt-hero__bg" aria-hidden="true">
      {%- if section.settings.background == 'image' and section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1920, 2400',
            sizes: '100vw',
            alt: ''
        }}
      {%- else -%}
        <img src="{{ 'kt-pitch.svg' | asset_url }}" alt="" width="1600" height="1000" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="page-width kt-hero__inner section-{{ section.id }}-padding">
    <div class="kt-hero__content kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="kt-hero__title">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_outline != blank -%}
          <br><em>{{ section.settings.heading_outline }}</em>
        {%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="kt-hero__actions">
        {%- if section.settings.button_label != blank and primary_link != blank -%}
          <a href="{{ primary_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank and section.settings.button_link_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="kt-hero__meta">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="kt-hero__media kt-reveal">
      {%- if hero_image != blank -%}
        {{
          hero_image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 550, 750, 1000, 1400',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: hero_image.alt
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if section.settings.badge_big != blank -%}
        <div class="kt-hero__badge">
          <strong>{{ section.settings.badge_big }}</strong>
          {{ section.settings.badge_small }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Úvod (hero)",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Pro fotbalisty 13–18 let" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Hraj naplno." },
    { "type": "text", "id": "heading_outline", "label": "Nadpis – obrysový řádek", "default": "Koleno pod kontrolou." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Kompresní bandáž, kterou si utáhneš na suchý zip přesně podle sebe. Drží při sprintu, nepřekáží v běhu.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Tlačítko 1 – text", "default": "Chci bandáž" },
    { "type": "url", "id": "button_link", "label": "Tlačítko 1 – odkaz", "info": "Když necháš prázdné, vede na vybraný produkt." },
    { "type": "text", "id": "button_label_2", "label": "Tlačítko 2 – text", "default": "Jak vybrat velikost" },
    { "type": "url", "id": "button_link_2", "label": "Tlačítko 2 – odkaz" },
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "image_picker", "id": "image", "label": "Obrázek", "info": "Když necháš prázdné, použije se hlavní fotka produktu." },
    { "type": "text", "id": "badge_big", "label": "Štítek u obrázku – velký text", "default": "2 ks = 790 Kč" },
    { "type": "text", "id": "badge_small", "label": "Štítek u obrázku – malý text", "default": "Na obě kolena" },
    {
      "type": "select",
      "id": "background",
      "label": "Pozadí",
      "options": [
        { "value": "pitch", "label": "Fotbalové hřiště (grafika)" },
        { "value": "image", "label": "Vlastní fotka" },
        { "value": "none", "label": "Jen barva" }
      ],
      "default": "pitch"
    },
    { "type": "image_picker", "id": "background_image", "label": "Fotka na pozadí", "info": "Použije se, když je u Pozadí vybraná Vlastní fotka. Ideálně na šířku, aspoň 2000 px." },
    { "type": "range", "id": "overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Ztmavení pozadí", "default": 55 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 24 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bod pod tlačítky",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Utažení na suchý zip" }]
    }
  ],
  "presets": [
    {
      "name": "KT – Úvod (hero)",
      "blocks": [
        { "type": "point", "settings": { "text": "Utažení na suchý zip" } },
        { "type": "point", "settings": { "text": "Protiskluzový pásek" } },
        { "type": "point", "settings": { "text": "Doručení do 14 dnů" } }
      ]
    }
  ]
}
{% endschema %}
