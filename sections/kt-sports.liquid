{%- comment -%}
  Pro všechny sporty: „Ověřeno na fotbale, funguje všude.“ Štítky se sporty,
  zvýrazněný sport (fotbal) má míč a odznak „Ověřeno“. Varianta „kompaktní“ je pro hlavní stránku.
{%- endcomment -%}
{{ 'kt-about.css' | asset_url | stylesheet_tag }}
{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-ab kt-sports{% if section.settings.compact %} kt-sports--compact{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width kt-ab__inner section-{{ section.id }}-padding">
    <div class="kt-sports__wrap">
      <div class="kt-sports__head kt-reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="kt-heading">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.text != blank -%}
          <div class="kt-lead-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="kt-sports__list kt-reveal" role="list">
          {%- for block in section.blocks -%}
            <li class="kt-sport{% if block.settings.main %} kt-sport--main{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.main -%}
                {%- render 'kt-icon', name: 'ball', class: 'kt-sport__icon' -%}
              {%- endif -%}
              <span>{{ block.settings.name }}</span>
              {%- if block.settings.main and block.settings.badge != blank -%}
                <span class="kt-sport__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="kt-sports__note kt-reveal">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Pro všechny sporty",
  "tag": "section",
  "class": "section",
  "max_blocks": 14,
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Kompaktní (nadpis vedle štítků)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Pro každý sport" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Ověřeno na fotbale. Funguje všude." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "textarea", "id": "note", "label": "Poznámka pod štítky (nepovinné)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "sport",
      "name": "Sport",
      "settings": [
        { "type": "text", "id": "name", "label": "Sport", "default": "Florbal" },
        { "type": "checkbox", "id": "main", "label": "Zvýraznit (náš hlavní sport)", "default": false },
        { "type": "text", "id": "badge", "label": "Odznak u zvýrazněného", "default": "Ověřeno" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KT – Pro všechny sporty",
      "blocks": [
        { "type": "sport", "settings": { "name": "Fotbal", "main": true } },
        { "type": "sport", "settings": { "name": "Florbal" } },
        { "type": "sport", "settings": { "name": "Basketbal" } },
        { "type": "sport", "settings": { "name": "Volejbal" } },
        { "type": "sport", "settings": { "name": "Běh" } }
      ]
    }
  ]
}
{% endschema %}
