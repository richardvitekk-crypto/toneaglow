{%- comment -%}
  Souhrn vybrané varianty těsně nad tlačítkem „Přidat do košíku“.
  Ukáže balení, barvu a velikost i s obvodem kolena, ať je jasné, co zákazník kupuje.
  Text aktualizuje kneetech.js při každé změně varianty.

  Accepts:
  - product {Object}
  - sizes {String} – velikosti s obvodem, např. 'S:30–33 cm|M:33–36 cm'
  - note {String} – drobný text pod souhrnem (doručení)
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign size_index = -1
  for option in product.options_with_values
    assign this_handle = option.name | handleize
    if this_handle == 'velikost' or this_handle == 'size'
      assign size_index = option.position | minus: 1
    endif
  endfor
  assign current_size = ''
  if size_index >= 0
    assign current_size = variant.options[size_index]
  endif
  assign current_range = ''
  assign size_pairs = sizes | split: '|'
  for pair in size_pairs
    assign parts = pair | split: ':'
    if parts.first == current_size
      assign current_range = parts.last
    endif
  endfor
-%}
<div class="kt-selection" data-kt-selection data-sizes="{{ sizes | escape }}" data-size-index="{{ size_index }}" data-t-size="{{ 'kneetech.selection.size_fit' | t | escape }}">
  <p class="kt-selection__label">{{ 'kneetech.selection.label' | t }}</p>
  <p class="kt-selection__value" data-kt-selection-value>{{ variant.title | replace: ' / ', ' · ' }}</p>
  {%- if size_index >= 0 -%}
    <p class="kt-selection__size">
      {% render 'kt-icon', name: 'ruler' -%}
      <span data-kt-selection-size>
        {%- if current_range != blank -%}
          {{ 'kneetech.selection.size_fit' | t | replace: '[size]', current_size | replace: '[range]', current_range }}
        {%- endif -%}
      </span>
    </p>
  {%- endif -%}
  {%- if note != blank -%}
    <p class="kt-selection__note">{{ note }}</p>
  {%- endif -%}
</div>
