{%- comment -%}
  Týmová objednávka – menší karta pod výběrem balení. 2 kusy zůstávají hlavní
  (a vybranou) volbou, tahle karta nic nepřepíná, jen rozbalí tabulku.
  V tabulce se vyplní počty pro každou velikost a barvu, vše jde do košíku
  jako varianty „1 kus“ a pak se přejde do košíku.

  Cena:
  - Na kartě se ukazuje metapole produktu custom.tymova_cena (Kč za kus)
    a minimum custom.tym_od_ks (výchozí 5).
  - Skutečnou cenu v košíku dělá automatická sleva v Shopify (Slevy) na varianty
    „1 kus“ od stejného počtu kusů. Obě čísla musí sedět.
  - Bez nastavené ceny zákazníci kartu nevidí, v editoru je vidět s upozorněním.

  Accepts:
  - product {Object}
  - pack_option {String}  – volba balení, výchozí „Balení“
  - color_option {String} – výchozí „Barva“
  - size_option {String}  – výchozí „Velikost“
  Texty jsou v jazykových souborech (kneetech.team.*). Názvy voleb se hledají i anglicky (Pack, Color, Size).
  - free_from {Number}    – od kolika Kč je doprava zdarma (výchozí 1500, musí sedět s nastavením dopravy v Shopify)
{%- endcomment -%}
{%- liquid
  assign pack_handle = pack_option | default: 'Balení' | handleize
  assign color_handle = color_option | default: 'Barva' | handleize
  assign size_handle = size_option | default: 'Velikost' | handleize
  assign pack_handles = 'baleni,pack,package,bundle' | split: ','
  assign color_handles = 'barva,color,colour' | split: ','
  assign size_handles = 'velikost,size' | split: ','
  assign root = routes.root_url | append: '/' | replace: '//', '/'

  assign pack_i = -1
  assign color_i = -1
  assign size_i = -1
  for name in product.options
    assign this_handle = name | handleize
    if this_handle == pack_handle or pack_handles contains this_handle
      assign pack_i = forloop.index0
    elsif this_handle == color_handle or color_handles contains this_handle
      assign color_i = forloop.index0
    elsif this_handle == size_handle or size_handles contains this_handle
      assign size_i = forloop.index0
    endif
  endfor

  assign team_price = product.metafields.custom.tymova_cena.value | default: 0 | plus: 0
  assign team_min = product.metafields.custom.tym_od_ks.value | default: 5 | plus: 0
  if team_min < 2
    assign team_min = 5
  endif

  assign single_price = 0
  assign pair_unit = 0
  assign colors_csv = ''
  assign sizes_csv = ''
  for variant in product.variants
    assign pack_qty = 1
    if pack_i >= 0
      assign pack_qty = variant.options[pack_i] | split: ' ' | first | plus: 0
      if pack_qty < 1
        assign pack_qty = 1
      endif
    endif
    if pack_qty > 1
      assign this_unit = variant.price | divided_by: pack_qty
      if pair_unit == 0 or this_unit < pair_unit
        assign pair_unit = this_unit
      endif
      continue
    endif
    if single_price == 0
      assign single_price = variant.price
    endif

    assign c = '–'
    if color_i >= 0
      assign c = variant.options[color_i]
    endif
    assign hay = '|' | append: colors_csv | append: '|'
    assign token = '|' | append: c | append: '|'
    unless hay contains token
      if colors_csv == ''
        assign colors_csv = c
      else
        assign colors_csv = colors_csv | append: '|' | append: c
      endif
    endunless

    assign s = '–'
    if size_i >= 0
      assign s = variant.options[size_i]
    endif
    assign hay = '|' | append: sizes_csv | append: '|'
    assign token = '|' | append: s | append: '|'
    unless hay contains token
      if sizes_csv == ''
        assign sizes_csv = s
      else
        assign sizes_csv = sizes_csv | append: '|' | append: s
      endif
    endunless
  endfor
  assign colors = colors_csv | split: '|'
  assign sizes = sizes_csv | split: '|'

  assign has_price = false
  if team_price > 0
    assign has_price = true
  endif
  assign team_price_cents = team_price | times: 100
  assign free_from = free_from | default: 1500 | plus: 0
  assign team_min_total = team_min | times: team_price
  assign team_free_shipping = false
  if has_price and free_from > 0 and team_min_total >= free_from
    assign team_free_shipping = true
  endif
  assign panel_id = 'KtTeam-' | append: product.id
-%}

{%- if single_price > 0 and sizes.size > 0 -%}
  {%- if has_price or request.design_mode -%}
    {{ 'kt-team.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'kt-team.js' | asset_url }}" defer="defer"></script>
    <kt-team
      class="kt-team"
      data-min="{{ team_min }}"
      data-price="{{ team_price }}"
      data-free="{{ free_from }}"
      data-cart="{{ routes.cart_url }}"
      data-add="{{ routes.cart_add_url }}"
      data-t-more="{{ 'kneetech.team.hint_more' | t | escape }}"
      data-t-ready="{{ 'kneetech.team.hint_ready' | t | escape }}"
      data-t-ready-free="{{ 'kneetech.team.hint_ready_free' | t | escape }}"
      data-t-start="{{ 'kneetech.team.hint_start' | t: min: team_min | escape }}"
      data-t-noprice="{{ 'kneetech.team.hint_noprice' | t | escape }}"
      data-t-total="{{ 'kneetech.team.total' | t | escape }}"
      data-t-error="{{ 'kneetech.team.error' | t | escape }}"
    >
      {%- if request.design_mode -%}
        {%- if has_price == false -%}
          <p class="kt-team__admin">
            Týmová cena zatím není nastavená, zákazníci tuhle kartu neuvidí. Doplň ji v produktu
            (metapole „Týmová cena“) a stejnou cenu nastav jako automatickou slevu.
          </p>
        {%- elsif pair_unit > 0 and team_price_cents >= pair_unit -%}
          <p class="kt-team__admin">
            Týmová cena {{ team_price_cents | money_without_trailing_zeros }}/ks není nižší než cena za kus
            ve 2 baleních ({{ pair_unit | money_without_trailing_zeros }}/ks), pro tým se nevyplatí.
          </p>
        {%- endif -%}
      {%- endif -%}

      <button type="button" class="kt-team__toggle" aria-expanded="false" aria-controls="{{ panel_id }}">
        <span class="kt-team__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c.6-3.3 3-5.3 6-5.3s5.4 2 6 5.3"/><circle cx="17" cy="9" r="2.6"/><path d="M16.2 14.3c2.6-.3 4.4 1.4 4.8 4.4"/></svg>
        </span>
        <span class="kt-team__main">
          <span class="kt-team__title">{{ 'kneetech.team.title' | t }}</span>
          <span class="kt-team__sub">{{ 'kneetech.team.from' | t: min: team_min }}{% if team_free_shipping %} · {{ 'kneetech.team.free_html' | t }}{% endif %} · {{ 'kneetech.team.mix' | t }}</span>
        </span>
        <span class="kt-team__price">
          {%- if has_price -%}
            <span class="kt-team__now">{{ team_price_cents | money_without_trailing_zeros }}</span>
            <span class="kt-team__unit">{{ 'kneetech.team.per_piece' | t }}</span>
          {%- else -%}
            <span class="kt-team__unit">{{ 'kneetech.team.price_soon' | t }}</span>
          {%- endif -%}
        </span>
        <span class="kt-team__chev" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>

      <div class="kt-team__panel" id="{{ panel_id }}" hidden>
        <p class="kt-team__intro">
          {{ 'kneetech.team.intro' | t }}
          {% if has_price -%}
            {%- assign team_price_money = team_price_cents | money_without_trailing_zeros -%}
            {{ 'kneetech.team.intro_price_html' | t: min: team_min, price: team_price_money }}
            {%- if team_free_shipping %}{{ 'kneetech.team.intro_free' | t }}{% endif %}.
          {%- endif %}
        </p>

        <div class="kt-team__scroll">
          <table class="kt-team__grid">
            <thead>
              <tr>
                <th scope="col">{{ 'kneetech.team.size' | t }}</th>
                {%- for color in colors -%}
                  <th scope="col">{{ color }}</th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for size in sizes -%}
                <tr>
                  <th scope="row">{{ size }}</th>
                  {%- for color in colors -%}
                    {%- liquid
                      assign cell_id = ''
                      assign cell_available = false
                      for variant in product.variants
                        assign pack_qty = 1
                        if pack_i >= 0
                          assign pack_qty = variant.options[pack_i] | split: ' ' | first | plus: 0
                        endif
                        if pack_qty > 1
                          continue
                        endif
                        assign vc = '–'
                        if color_i >= 0
                          assign vc = variant.options[color_i]
                        endif
                        assign vs = '–'
                        if size_i >= 0
                          assign vs = variant.options[size_i]
                        endif
                        if vc == color and vs == size
                          assign cell_id = variant.id
                          assign cell_available = variant.available
                          break
                        endif
                      endfor
                      assign cell_label = size | append: ', ' | append: color
                    -%}
                    <td>
                      {%- if cell_id != '' and cell_available -%}
                        <div class="kt-team__step">
                          <button type="button" data-kt-step="-1" aria-label="{{ 'kneetech.team.minus' | t: label: cell_label | escape }}">−</button>
                          <input
                            type="number"
                            inputmode="numeric"
                            min="0"
                            max="99"
                            value="0"
                            data-kt-variant="{{ cell_id }}"
                            aria-label="{{ 'kneetech.team.qty' | t: label: cell_label | escape }}"
                          >
                          <button type="button" data-kt-step="1" aria-label="{{ 'kneetech.team.plus' | t: label: cell_label | escape }}">+</button>
                        </div>
                      {%- else -%}
                        <span class="kt-team__na">{{ 'kneetech.team.sold_out' | t }}</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        <a class="kt-team__sizes" href="{{ root }}pages/velikosti" data-kt-size-open aria-controls="kt-size-dialog" aria-haspopup="dialog">
          {%- render 'kt-icon', name: 'ruler' -%}
          {{ 'kneetech.team.sizes_link' | t }}
        </a>

        <div class="kt-team__sum" aria-live="polite">
          <p class="kt-team__count"><strong data-kt-team-count>0</strong> {{ 'kneetech.team.pcs' | t }}</p>
          <p class="kt-team__total" data-kt-team-total></p>
        </div>
        <p class="kt-team__hint" data-kt-team-hint>{{ 'kneetech.team.hint_start' | t: min: team_min }}</p>

        <button type="button" class="kt-team__add" data-kt-team-add disabled>{{ 'kneetech.team.add' | t }}</button>
        <p class="kt-team__note">{{ 'kneetech.team.note' | t }}</p>
        <p class="kt-team__error" data-kt-team-error role="alert" hidden></p>
      </div>
    </kt-team>
  {%- endif -%}
{%- endif -%}
