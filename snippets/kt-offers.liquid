{%- comment -%}
  Výběr balení (1 kus / 2 kusy) jako velké karty.
  Karty přepínají skrytou volbu „Balení“ v přepínači variant Dawn,
  takže cena, košík i dostupnost fungují standardně.
  Cena za kus se bere z hodnoty s 1 kusem (nezáleží na pořadí hodnot),
  výhodnější balení se vždy ukáže jako první.

  Accepts:
  - product {Object}
  - option_name {String} – název volby, výchozí „Balení“
  - badge {String} – štítek u nejvýhodnější volby
{%- endcomment -%}
{%- liquid
  assign option_name = option_name | default: 'Balení'
  assign option_handle = option_name | handleize
  assign target_option = null
  for option in product.options_with_values
    assign this_handle = option.name | handleize
    if this_handle == option_handle
      assign target_option = option
    endif
  endfor
-%}

{%- if target_option != null and target_option.values.size > 1 -%}
  {%- liquid
    assign option_index = target_option.position | minus: 1
    assign single_price = 0
    for value in target_option.values
      assign value_qty = value.name | split: ' ' | first | plus: 0
      if value_qty <= 1
        for variant in product.variants
          if variant.options[option_index] == value.name
            assign single_price = variant.price
            break
          endif
        endfor
        break
      endif
    endfor
  -%}
  <kt-offers class="kt-offers-wrap" data-option="{{ option_handle }}">
    <p class="kt-offers__label" id="kt-offers-label-{{ product.id }}">{{ target_option.name }}</p>
    <div role="radiogroup" aria-labelledby="kt-offers-label-{{ product.id }}" class="kt-offers">
      {%- for pass in (1..2) -%}
        {%- for value in target_option.values -%}
          {%- liquid
            assign qty = value.name | split: ' ' | first | plus: 0
            if qty < 1
              assign qty = 1
            endif
            assign show_offer = true
            if pass == 1 and qty == 1
              assign show_offer = false
            endif
            if pass == 2 and qty > 1
              assign show_offer = false
            endif
            assign value_price = 0
            for variant in product.variants
              if variant.options[option_index] == value.name
                assign value_price = variant.price
                break
              endif
            endfor
            assign full_price = single_price | times: qty
            assign saving = full_price | minus: value_price
            assign unit_price = value_price | divided_by: qty
            assign is_best = false
            if qty > 1 and saving > 0 and single_price > 0
              assign is_best = true
            endif
          -%}
          {%- if show_offer -%}
          <button
            type="button"
            role="radio"
            class="kt-offer{% if is_best %} kt-offer--best{% endif %}{% if value.selected %} is-active{% endif %}"
            data-value="{{ value.name | escape }}"
            aria-checked="{% if value.selected %}true{% else %}false{% endif %}"
          >
            {%- if is_best and badge != blank -%}
              <span class="kt-offer__badge">{{ badge }}</span>
            {%- endif -%}
            <span class="kt-offer__radio" aria-hidden="true"></span>
            <span class="kt-offer__main">
              <span class="kt-offer__title">{{ value.name }}</span>
              <span class="kt-offer__sub">
                {%- if qty > 1 -%}
                  Na obě kolena · {{ unit_price | money_without_trailing_zeros }} za kus
                {%- else -%}
                  Na jedno koleno
                {%- endif -%}
              </span>
              {%- if is_best -%}
                <span class="kt-offer__save">Ušetříš {{ saving | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </span>
            <span class="kt-offer__price">
              {%- if is_best -%}
                <s class="kt-offer__compare">
                  <span class="visually-hidden">Jednotlivě by stály</span>
                  {{- full_price | money_without_trailing_zeros -}}
                </s>
              {%- endif -%}
              <span class="kt-offer__now">{{ value_price | money_without_trailing_zeros }}</span>
            </span>
          </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </kt-offers>
{%- endif -%}
