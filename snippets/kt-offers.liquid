{%- comment -%}
  Výběr balení (1 kus / 2 kusy) jako velké karty – nastavené tak, aby táhly 2 kusy.
  Karty přepínají skrytou volbu „Balení“ v přepínači variant Dawn,
  takže cena, košík i dostupnost fungují standardně.
  Všechna čísla se počítají z cen variant (nic natvrdo):
  přeškrtnutá cena = cena 1 kusu × počet kusů (nákup po kusech), ne „původní cena“.
  Sleva na druhý kus = úspora ÷ cena 1 kusu (790 vs. 2 × 590 → druhý kus za 200 místo 590 = −66 %).
  Výhodnější balení se vždy ukáže jako první.
  Hodnoty volby se berou přímo z variant (product.options + variant.options) – bez options_with_values.
  V editoru se při chybě ukáže červená kontrolní hláška.

  Accepts:
  - product {Object}
  - option_name {String} – název volby, výchozí „Balení“
  - recommend {String} – štítek u nejvýhodnější volby (výchozí „Doporučujeme“)
  - reasons {String} – důvody pro víc kusů, oddělené „|“
{%- endcomment -%}
{%- liquid
  assign option_name = option_name | default: 'Balení'
  assign option_handle = option_name | handleize
  assign recommend = recommend | default: 'Doporučujeme'
  assign reasons = reasons | default: 'Stejná opora pro obě kolena|Začne zlobit i druhé koleno? Máš ji hned po ruce|Jedna se pere, druhá je připravená na trénink'

  assign option_index = -1
  assign option_label = option_name
  for name in product.options
    assign this_handle = name | handleize
    if this_handle == option_handle
      assign option_index = forloop.index0
      assign option_label = name
    endif
  endfor

  assign values_csv = ''
  if option_index >= 0
    for variant in product.variants
      assign v = variant.options[option_index]
      assign hay = '|' | append: values_csv | append: '|'
      assign token = '|' | append: v | append: '|'
      unless hay contains token
        if values_csv == ''
          assign values_csv = v
        else
          assign values_csv = values_csv | append: '|' | append: v
        endif
      endunless
    endfor
  endif
  assign option_values = values_csv | split: '|'
  assign selected_value = ''
  if option_index >= 0
    assign selected_value = product.selected_or_first_available_variant.options[option_index]
  endif
-%}

{%- if option_index < 0 or option_values.size < 2 -%}
  {%- if request.design_mode -%}
    <p style="padding:1rem;border:1px dashed #f66;color:#f66;font-size:1.3rem">
      KT balení: nenašel jsem volbu „{{ option_name }}“ (volby produktu: {{ product.options | join: ', ' }}).
    </p>
  {%- endif -%}
{%- else -%}
  {%- liquid
    assign single_price = 0
    for value in option_values
      assign value_qty = value | split: ' ' | first | plus: 0
      if value_qty <= 1 and single_price == 0
        for variant in product.variants
          if variant.options[option_index] == value and single_price == 0
            assign single_price = variant.price
          endif
        endfor
      endif
    endfor

    assign best_value = ''
    assign best_price = 0
    assign best_saving = 0
    for value in option_values
      assign value_qty = value | split: ' ' | first | plus: 0
      if value_qty > 1
        assign candidate_price = 0
        for variant in product.variants
          if variant.options[option_index] == value and candidate_price == 0
            assign candidate_price = variant.price
          endif
        endfor
        assign candidate_saving = single_price | times: value_qty | minus: candidate_price
        if candidate_saving > best_saving
          assign best_value = value
          assign best_price = candidate_price
          assign best_saving = candidate_saving
        endif
      endif
    endfor
    assign upsell_extra = best_price | minus: single_price
    assign extra_pct = 0
    if single_price > 0 and best_saving > 0
      assign extra_pct = best_saving | times: 100 | divided_by: single_price
    endif
    assign reason_list = reasons | split: '|'
  -%}
  {{ 'kt-offers.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kt-landing.js' | asset_url }}" defer="defer"></script>
  <kt-offers class="kt-offers-wrap kt-offers-v2" data-option="{{ option_handle }}">
    <div class="kt-offers__head">
      <p class="kt-offers__label" id="kt-offers-label-{{ product.id }}">Vyber {{ option_label | downcase }}</p>
      {%- if best_saving > 0 -%}
        <p class="kt-offers__tip">Fotbal zatěžuje obě kolena</p>
      {%- endif -%}
    </div>
    <div role="radiogroup" aria-labelledby="kt-offers-label-{{ product.id }}" class="kt-offers">
      {%- for pass in (1..2) -%}
        {%- for value in option_values -%}
          {%- liquid
            assign qty = value | split: ' ' | first | plus: 0
            if qty < 1
              assign qty = 1
            endif
            assign show_offer = true
            if pass == 1 and qty == 1
              assign show_offer = false
            endif
            if pass == 2 and qty > 1
              assign show_offer = false
            endif
            assign value_price = 0
            for variant in product.variants
              if variant.options[option_index] == value and value_price == 0
                assign value_price = variant.price
              endif
            endfor
            assign full_price = single_price | times: qty
            assign saving = full_price | minus: value_price
            assign unit_price = value_price | divided_by: qty
            assign percent = 0
            if full_price > 0
              assign percent = saving | times: 100 | divided_by: full_price
            endif
            assign is_best = false
            if qty > 1 and saving > 0 and single_price > 0
              assign is_best = true
            endif
          -%}
          {%- if show_offer -%}
            <button
              type="button"
              role="radio"
              class="kt-offer{% if is_best %} kt-offer--best{% endif %}{% if value == selected_value %} is-active{% endif %}"
              data-value="{{ value | escape }}"
              aria-checked="{% if value == selected_value %}true{% else %}false{% endif %}"
            >
              {%- if is_best -%}
                <span class="kt-offer__badge">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2-4.6-4.4 6.3-.9L12 2.8Z" fill="currentColor"/></svg>
                  {{ recommend }}
                </span>
                {%- if extra_pct > 0 -%}
                  <span class="kt-offer__pct" aria-hidden="true"><small>2.&nbsp;kus</small>−{{ extra_pct }}&nbsp;%</span>
                {%- endif -%}
              {%- endif -%}
              <span class="kt-offer__radio" aria-hidden="true"></span>
              <span class="kt-offer__main">
                <span class="kt-offer__title">{{ value }}</span>
                <span class="kt-offer__sub">
                  {%- if qty > 1 -%}
                    Na obě kolena
                  {%- elsif upsell_extra > 0 -%}
                    Na jedno koleno · za +{{ upsell_extra | money_without_trailing_zeros }} máš {{ best_value | downcase }}
                  {%- else -%}
                    Na jedno koleno
                  {%- endif -%}
                </span>
              </span>
              <span class="kt-offer__price">
                {%- if is_best -%}
                  <s class="kt-offer__compare">
                    <span class="visually-hidden">Po kusech by stály</span>
                    {{- full_price | money_without_trailing_zeros -}}
                  </s>
                {%- endif -%}
                <span class="kt-offer__now">{{ value_price | money_without_trailing_zeros }}</span>
                <span class="kt-offer__unit">
                  {%- if is_best -%}jen {% endif -%}
                  {{- unit_price | money_without_trailing_zeros }} / ks
                </span>
              </span>
              {%- if is_best -%}
                <span class="kt-offer__why">
                  {%- for reason in reason_list -%}
                    {%- assign reason_text = reason | strip -%}
                    {%- if reason_text != blank -%}
                      <span class="kt-offer__why-item">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {{ reason_text }}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="kt-offer__savebar">
                  Druhá bandáž o <strong>{{ extra_pct }}&nbsp;% levěji</strong> – ušetříš {{ saving | money_without_trailing_zeros }}
                </span>
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if best_saving > 0 and upsell_extra > 0 -%}
      <div class="kt-upsell" role="note">
        <p class="kt-upsell__text">
          Co druhé koleno? <strong>Druhý kus jen za +{{ upsell_extra | money_without_trailing_zeros }}</strong>
          – o {{ extra_pct }}&nbsp;% levěji, ušetříš {{ best_saving | money_without_trailing_zeros }}.
        </p>
        <button type="button" class="kt-upsell__button" data-kt-upsell="{{ best_value | escape }}">
          Chci {{ best_value | downcase }}
        </button>
      </div>
    {%- endif -%}
  </kt-offers>
{%- endif -%}
