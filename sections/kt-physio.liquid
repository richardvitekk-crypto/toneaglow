{%- comment -%}
  Doporučený fyzioterapeut – karta odborníka, kterého KNEETECH doporučuje.
  Bloky „Fyzioterapeut“ (max. 3). Karta se ukáže, jen když má vyplněné jméno
  a není skrytá. Režim „okno“ (výchozí): sekce je na stránce neviditelná a otevře
  se jako <dialog> po kliknutí na odkaz #fyzioterapeut (karta Bezpečné nošení).
  Výzva „Napiš nám“ se v okně ukáže jen tehdy, když ještě není vyplněný nikdo.
  Vyplňuj jen skutečného člověka s jeho souhlasem (jméno, fotka, citace).
{%- endcomment -%}
{%- render 'kt-section-padding', section: section -%}
{{ 'kt-fyzio.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor = section.settings.anchor | default: 'fyzioterapeut' | handleize
  assign visible = 0
  for block in section.blocks
    if block.settings.hidden == false and block.settings.name != blank
      assign visible = visible | plus: 1
    endif
  endfor
  assign default_contact = routes.root_url | append: '/pages/contact' | replace: '//', '/'
  assign contact_url = section.settings.cta_link | default: default_contact
-%}

{%- liquid
  assign popup = false
  if section.settings.mode == 'popup'
    assign popup = true
  endif
  assign show_cta = section.settings.show_cta
  if popup and visible > 0
    assign show_cta = false
  endif
-%}

{%- if popup -%}
  <div id="{{ anchor }}" class="kt-physio-anchor">
    {%- if request.design_mode -%}
      <div class="page-width kt-physio__editor">
        <strong>KT – Fyzioterapeut (okno)</strong>
        Na webu se tahle sekce zobrazí jen jako okno po kliknutí na limetkové tlačítko v kartě Bezpečné nošení.
        <button type="button" class="kt-physio__btn kt-physio__btn--primary" data-kt-physio-open>Otevřít náhled okna</button>
      </div>
    {%- endif -%}
  </div>
  <dialog id="kt-physio-dialog" class="kt-physio-dialog color-{{ section.settings.color_scheme }}" aria-labelledby="kt-physio-dialog-title">
    <button type="button" class="kt-physio-dialog__close" data-kt-physio-close aria-label="{{ 'accessibility.close' | t | escape }}">
      {%- render 'kt-icon', name: 'cross' -%}
    </button>
    <div class="kt-physio-dialog__inner">
{%- endif -%}

{%- if popup or visible > 0 or section.settings.show_cta or request.design_mode -%}
  {%- unless popup -%}
  <div id="{{ anchor }}" class="kt-section kt-physio color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
  {%- endunless -%}
      <div class="kt-physio__head kt-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kt-heading kt-heading--md" id="kt-physio-dialog-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="kt-lead-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if visible > 0 -%}
        <div class="kt-physio__list{% if visible == 1 %} kt-physio__list--single{% endif %}">
          {%- for block in section.blocks -%}
            {%- if block.settings.hidden or block.settings.name == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign tags = block.settings.tags | split: ','
              assign alt = block.settings.name
              if block.settings.role != blank
                assign alt = alt | append: ' – ' | append: block.settings.role
              endif
            -%}
            <article class="kt-physio__card kt-reveal" {{ block.shopify_attributes }}>
              <div class="kt-physio__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'kt-physio__img',
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 990px) 380px, (min-width: 750px) 40vw, 90vw',
                      alt: alt
                  }}
                {%- else -%}
                  <div class="kt-physio__img kt-physio__img--empty" aria-hidden="true">
                    {%- render 'kt-icon', name: 'knee', class: 'kt-physio__placeholder' -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="kt-physio__badge">
                    {%- render 'kt-icon', name: 'shield', class: 'kt-physio__badge-icon' -%}
                    {{ block.settings.badge }}
                  </span>
                {%- endif -%}
              </div>

              <div class="kt-physio__body">
                <h3 class="kt-physio__name">{{ block.settings.name }}</h3>
                {%- if block.settings.role != blank -%}
                  <p class="kt-physio__role">{{ block.settings.role }}</p>
                {%- endif -%}

                {%- if block.settings.clinic != blank or block.settings.city != blank -%}
                  <p class="kt-physio__place">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                    <span>
                      {{- block.settings.clinic -}}
                      {%- if block.settings.clinic != blank and block.settings.city != blank %} · {% endif -%}
                      {{- block.settings.city -}}
                    </span>
                  </p>
                {%- endif -%}

                {%- if block.settings.tags != blank -%}
                  <ul class="kt-physio__tags" role="list">
                    {%- for tag in tags -%}
                      {%- assign t = tag | strip -%}
                      {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                {%- if block.settings.bio != blank -%}
                  <div class="kt-physio__bio">{{ block.settings.bio }}</div>
                {%- endif -%}

                {%- if block.settings.quote != blank -%}
                  <blockquote class="kt-physio__quote">{{ block.settings.quote | escape | newline_to_br }}</blockquote>
                {%- endif -%}

                <div class="kt-physio__actions">
                  {%- if block.settings.book_link != blank -%}
                    <a class="kt-physio__btn kt-physio__btn--primary" href="{{ block.settings.book_link }}" target="_blank" rel="noopener">
                      {{ block.settings.book_label | default: 'Objednat se' }}
                      {%- render 'kt-icon', name: 'arrow', class: 'kt-physio__btn-icon' -%}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    {%- assign tel = block.settings.phone | remove: ' ' -%}
                    <a class="kt-physio__btn" href="tel:{{ tel }}">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                      {{ block.settings.phone }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode and popup == false -%}
        <div class="kt-physio__empty">
          <strong>Zatím tu není žádný fyzioterapeut.</strong>
          Vlevo klikni na „Přidat blok → Fyzioterapeut“ a vyplň fotku, jméno, kliniku, město, zaměření a odkaz na objednání.
          Na webu se karta ukáže, až bude vyplněné jméno. Dokud tu nikdo není, zákazníci uvidí jen výzvu „Napiš nám“ níže.
        </div>
      {%- endif -%}

      {%- if show_cta -%}
        <div class="kt-physio__cta kt-reveal">
          {%- render 'kt-icon', name: 'chat', class: 'kt-physio__cta-icon' -%}
          <div class="kt-physio__cta-text">
            {%- if section.settings.cta_title != blank -%}<p class="kt-physio__cta-title">{{ section.settings.cta_title }}</p>{%- endif -%}
            {%- if section.settings.cta_text != blank -%}<div class="kt-physio__cta-sub">{{ section.settings.cta_text }}</div>{%- endif -%}
          </div>
          {%- if section.settings.cta_label != blank -%}
            <a class="kt-physio__btn kt-physio__btn--primary" href="{{ contact_url }}">
              {{ section.settings.cta_label }}
              {%- render 'kt-icon', name: 'arrow', class: 'kt-physio__btn-icon' -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="kt-physio__note">{{ section.settings.note }}</p>
      {%- endif -%}
  {%- unless popup -%}
    </div>
  </div>
  {%- endunless -%}
{%- endif -%}

{%- if popup -%}
    </div>
  </dialog>
  <script>
    (function () {
      if (window.ktPhysioInit) return;
      window.ktPhysioInit = true;
      function dlg() {
        return document.getElementById('kt-physio-dialog');
      }
      function open() {
        var d = dlg();
        if (!d || typeof d.showModal !== 'function') return false;
        if (!d.open) d.showModal();
        return true;
      }
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-kt-physio-open], a[href$="#{{ anchor }}"]');
        if (t) {
          if (open()) e.preventDefault();
          return;
        }
        var d = dlg();
        if (!d || !d.open) return;
        if (e.target.closest('[data-kt-physio-close]') || e.target === d) d.close();
      });
      document.addEventListener('shopify:block:select', function (e) {
        if (e.target && e.target.closest && e.target.closest('#kt-physio-dialog')) open();
      });
      document.addEventListener('shopify:block:deselect', function (e) {
        var d = dlg();
        if (d && d.open && e.target && e.target.closest && e.target.closest('#kt-physio-dialog')) d.close();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "KT – Fyzioterapeut",
  "tag": "section",
  "class": "section kt-physio-section",
  "max_blocks": 3,
  "settings": [
    { "type": "paragraph", "content": "Doporučený odborník. Karta se zobrazí, až vyplníš jméno. Uváděj jen skutečného člověka s jeho souhlasem se zveřejněním jména, fotky a citace." },
    {
      "type": "select",
      "id": "mode",
      "label": "Zobrazení",
      "options": [
        { "value": "popup", "label": "Okno po kliknutí (jako tabulka velikostí)" },
        { "value": "section", "label": "Celá sekce na stránce" }
      ],
      "default": "popup",
      "info": "Okno otevře tlačítko v kartě Bezpečné nošení (odkaz #fyzioterapeut)."
    },
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Doporučený odborník" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Fyzioterapeut, kterému věříme" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bandáž kolenu pomůže při sportu, ale bolest, která neodchází, patří do rukou odborníka. Tady je člověk, ke kterému bychom poslali i vlastní hráče.</p>" },
    { "type": "header", "content": "Výzva „Napiš nám“" },
    { "type": "checkbox", "id": "show_cta", "label": "Zobrazit výzvu", "default": true, "info": "V režimu okna se ukáže jen tehdy, když ještě nemáš vyplněného fyzioterapeuta." },
    { "type": "text", "id": "cta_title", "label": "Nadpis výzvy", "default": "Hledáš fyzioterapeuta?" },
    { "type": "richtext", "id": "cta_text", "label": "Text výzvy", "default": "<p>Napiš nám, odkud jsi a co tě trápí. Doporučíme ti fyzioterapeuta, kterému věříme.</p>" },
    { "type": "text", "id": "cta_label", "label": "Tlačítko výzvy", "default": "Chci doporučit" },
    { "type": "url", "id": "cta_link", "label": "Odkaz výzvy" },
    { "type": "header", "content": "Ostatní" },
    { "type": "text", "id": "note", "label": "Poznámka pod sekcí (nepovinné)", "info": "Např. „Za doporučení si navzájem nic neplatíme.“ Když spolupráce placená je, napiš to sem." },
    { "type": "text", "id": "anchor", "label": "Kotva (id sekce)", "default": "fyzioterapeut", "info": "Na tuto kotvu vede odkaz z karty Bezpečné nošení. Neměň, pokud nemusíš." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 96 }
  ],
  "blocks": [
    {
      "type": "therapist",
      "name": "Fyzioterapeut",
      "settings": [
        { "type": "checkbox", "id": "hidden", "label": "Skrýt kartu (bez mazání)", "default": false },
        { "type": "image_picker", "id": "image", "label": "Fotka", "info": "Ideálně na výšku (4:5), světlé pozadí nebo v ordinaci. Jen se souhlasem." },
        { "type": "text", "id": "badge", "label": "Štítek na fotce", "default": "Doporučujeme" },
        { "type": "text", "id": "name", "label": "Jméno a titul", "placeholder": "Mgr. Jan Novák" },
        { "type": "text", "id": "role", "label": "Role", "default": "Sportovní fyzioterapeut" },
        { "type": "text", "id": "clinic", "label": "Klinika / ordinace", "placeholder": "Fyzio Centrum Brno" },
        { "type": "text", "id": "city", "label": "Město", "placeholder": "Brno" },
        { "type": "text", "id": "tags", "label": "Zaměření (oddělené čárkou)", "placeholder": "Kolena, Mladí sportovci, Návrat po zranění" },
        { "type": "richtext", "id": "bio", "label": "Krátce o něm/ní", "info": "2–3 věty: zkušenosti, s kým pracuje, proč ho doporučujete." },
        { "type": "textarea", "id": "quote", "label": "Citace (nepovinné)", "placeholder": "Co by vzkázal mladým fotbalistům s bolavým kolenem…" },
        { "type": "url", "id": "book_link", "label": "Odkaz na objednání / web" },
        { "type": "text", "id": "book_label", "label": "Text tlačítka", "default": "Objednat se" },
        { "type": "text", "id": "phone", "label": "Telefon (nepovinné)" }
      ]
    }
  ],
  "presets": [
    { "name": "KT – Fyzioterapeut" }
  ]
}
{% endschema %}
