{%- comment -%}
  SVG fotbalový míč jako <symbol> – vykreslí se jednou na stránku a kuličky
  hodnocení na něj odkazují přes <use>. Barvy: --kt-ball-body, --kt-ball-line a --kt-ball-rim (obrys).
  Parametr id: id symbolu (výchozí kt-ball).
{%- endcomment -%}
{%- assign sprite_id = id | default: 'kt-ball' -%}
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="{{ sprite_id }}-clip"><circle cx="12" cy="12" r="10.6"/></clipPath>
    <symbol id="{{ sprite_id }}" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10.6" style="fill: var(--kt-ball-body, #fff)"/>
      <g style="fill: var(--kt-ball-line, #0a0a0a)" clip-path="url(#{{ sprite_id }}-clip)">
        <polygon points="12.00 8.30 15.52 10.86 14.17 14.99 9.83 14.99 8.48 10.86"/>
        <path d="M12.00 5.10L7.28 1.40L12.00 -1.00L16.72 1.40ZM18.56 9.87L20.62 4.24L24.36 7.98L23.54 13.21ZM16.06 17.58L22.05 17.80L19.64 22.52L14.41 23.35ZM7.94 17.58L9.59 23.35L4.36 22.52L1.95 17.80ZM5.44 9.87L0.46 13.21L-0.36 7.98L3.38 4.24Z"/>
      </g>
      <path d="M12.00 8.30L12.00 5.10M15.52 10.86L18.56 9.87M14.17 14.99L16.06 17.58M9.83 14.99L7.94 17.58M8.48 10.86L5.44 9.87" style="stroke: var(--kt-ball-line, #0a0a0a)" stroke-width="1.3" fill="none"/>
      <circle cx="12" cy="12" r="10.6" fill="none" style="stroke: var(--kt-ball-rim, var(--kt-ball-line, #0a0a0a))" stroke-width="1.3"/>
    </symbol>
  </defs>
</svg>
