{%- render 'kt-section-padding', section: section -%}

{%- if section.blocks.size > 0 -%}
  <div
    class="kt-section kt-marquee color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
    style="--kt-marquee-speed: {{ section.settings.speed }}s;"
  >
    <div class="kt-marquee__track">
      {%- for i in (1..2) -%}
        <div class="kt-marquee__group"{% if forloop.index == 2 %} aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <span class="kt-marquee__item"{% if forloop.parentloop.first and i == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {{- block.settings.text -}}
              </span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "KT – Běžící pás",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "range", "id": "speed", "min": 10, "max": 80, "step": 2, "unit": "s", "label": "Rychlost (delší = pomalejší)", "default": 36 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 0 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Komprese" }]
    }
  ],
  "presets": [
    {
      "name": "KT – Běžící pás",
      "blocks": [
        { "type": "item", "settings": { "text": "Komprese" } },
        { "type": "item", "settings": { "text": "Opora" } },
        { "type": "item", "settings": { "text": "Suchý zip" } },
        { "type": "item", "settings": { "text": "Protiskluz" } },
        { "type": "item", "settings": { "text": "Jen 70 g" } }
      ]
    }
  ]
}
{% endschema %}
