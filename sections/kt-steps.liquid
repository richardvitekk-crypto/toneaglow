{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-steps color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="kt-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="kt-steps__grid">
        {%- for block in section.blocks -%}
          <div class="kt-step kt-reveal" {{ block.shopify_attributes }}>
            <h3 class="kt-step__title">{{ block.settings.title }}</h3>
            <div class="kt-step__text">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Kroky",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Nasazení" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Hotovo za 20 vteřin" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Krok",
      "settings": [
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Nasaď" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Popis kroku.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "KT – Kroky", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
