{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-compare color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-center kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="kt-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <table class="kt-compare__table kt-reveal">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Vlastnost</span></th>
            <th scope="col" class="kt-compare__us">{{ section.settings.us_label }}</th>
            <th scope="col">{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td class="kt-compare__us">
                {%- if block.settings.us -%}
                  <span class="kt-compare__yes">{% render 'kt-icon', name: 'check' %}<span class="visually-hidden">Ano</span></span>
                {%- else -%}
                  <span class="kt-compare__no">{% render 'kt-icon', name: 'cross' %}<span class="visually-hidden">Ne</span></span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.them -%}
                  <span class="kt-compare__yes">{% render 'kt-icon', name: 'check' %}<span class="visually-hidden">Ano</span></span>
                {%- else -%}
                  <span class="kt-compare__no">{% render 'kt-icon', name: 'cross' %}<span class="visually-hidden">Ne</span></span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – Srovnání",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Srovnání" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Proč ne obyčejný návlek" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "us_label", "label": "Náš sloupec", "default": "KNEETECH" },
    { "type": "text", "id": "them_label", "label": "Druhý sloupec", "default": "Obyčejný návlek" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Řádek",
      "settings": [
        { "type": "text", "id": "label", "label": "Vlastnost", "default": "Komprese" },
        { "type": "checkbox", "id": "us", "label": "KNEETECH má", "default": true },
        { "type": "checkbox", "id": "them", "label": "Druhý sloupec má", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "KT – Srovnání", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }
  ]
}
{% endschema %}
