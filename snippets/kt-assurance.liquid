{%- comment -%}
  Pravdivé informace pod tlačítkem „Přidat do košíku“: doručení, vrácení, platby.
  Nahrazuje původní ikonky (vrácení / platba / poradíme).
  Accepts:
  - delivery {String}      – např. 'Doručení do 14 dnů'
  - delivery_sub {String}  – např. 'Se sledováním zásilky'
  - returns {String}       – např. '14 dní na vrácení'
  - returns_sub {String}   – např. 'Bez udání důvodu'
  - link {String}          – odkaz na podrobnosti (výchozí /pages/doprava-a-vraceni)
  - brand {String}         – řádek se značkou (výchozí „Česká značka z Brna“, '-' skryje)
  - payments {Boolean}     – false skryje ikony plateb

  Ikony plateb se berou ze skutečně zapnutých plateb v Shopify (shop.enabled_payment_types),
  takže ukazují jen to, co jde opravdu zaplatit.

  Termín nad seznamem („odešleme do …, doručíme nejpozději …“) počítá prohlížeč z dnešního data
  v kalendářních dnech: odeslání do 4 dnů, doručení nejpozději do 14 dnů od objednávky
  (4 dny odeslání + 10 dnů doručení). Když datum vyjde na sobotu, neděli nebo český státní
  svátek (i Velikonoce), posune se na další pracovní den – kurýři o víkendu nedoručují.
  Bez JavaScriptu se řádek neukáže.
  - ship_days {Number}     – dny do odeslání (výchozí 4)
  - delivery_days {Number} – dny do doručení od objednávky (výchozí 14)
{%- endcomment -%}
{{ 'kt-landing.css' | asset_url | stylesheet_tag }}
{{ 'kt-popis.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign root = routes.root_url | append: '/' | replace: '//', '/'
  assign d_delivery = 'kneetech.assure.delivery' | t
  assign d_delivery_sub = 'kneetech.assure.delivery_sub' | t
  assign d_returns = 'kneetech.assure.returns' | t
  assign d_returns_sub = 'kneetech.assure.returns_sub' | t
  assign d_link = root | append: 'pages/doprava-a-vraceni'
  assign d_brand = 'kneetech.assure.brand' | t
  assign delivery = delivery | default: d_delivery
  assign delivery_sub = delivery_sub | default: d_delivery_sub
  assign returns = returns | default: d_returns
  assign returns_sub = returns_sub | default: d_returns_sub
  assign link = link | default: d_link
  assign brand = brand | default: d_brand
  assign ship_days = ship_days | default: 4
  assign delivery_days = delivery_days | default: 14
-%}
{%- style -%}
  .kt-eta {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin: 0 0 1.2rem;
    padding: 0 0 1.2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    font-size: 1.35rem;
    line-height: 1.45;
    color: rgba(var(--color-foreground), 0.85);
  }
  .kt-eta[hidden] {
    display: none;
  }
  .kt-eta strong {
    color: rgb(var(--color-foreground));
    white-space: nowrap;
  }
  .kt-eta__dot {
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.6rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--kt-lime, #d8ff3e);
    box-shadow: 0 0 0 0.4rem rgba(216, 255, 62, 0.18);
  }
{%- endstyle -%}
<div class="kt-assure">
  <p class="kt-eta" data-kt-eta data-ship="{{ ship_days }}" data-delivery="{{ delivery_days }}" hidden>
    <span class="kt-eta__dot" aria-hidden="true"></span>
    <span data-kt-eta-text></span>
  </p>
  <ul class="kt-assure__list">
    <li>
      {% render 'kt-icon', name: 'truck', class: 'kt-assure__icon' %}
      <span><strong>{{ delivery }}</strong>{% if delivery_sub != blank %}<small>{{ delivery_sub }}</small>{% endif %}</span>
    </li>
    <li>
      {% render 'kt-icon', name: 'return', class: 'kt-assure__icon' %}
      <span><strong>{{ returns }}</strong>{% if returns_sub != blank %}<small>{{ returns_sub }}</small>{% endif %}</span>
    </li>
  </ul>

  <div class="kt-trust">
    {%- if brand != '-' -%}
      <p class="kt-trust__brand">
        <svg class="kt-trust__flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="10" fill="#fff"/><rect y="10" width="30" height="10" fill="#d7141a"/><path d="M0 0 15 10 0 20Z" fill="#11457e"/></svg>
        {{ brand }}
      </p>
    {%- endif -%}
    <p class="kt-trust__secure">
      {%- render 'kt-icon', name: 'lock', class: 'kt-trust__lock' -%}
      {{ 'kneetech.assure.secure' | t }}
    </p>
    {%- unless payments == false -%}
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="kt-trust__pay" role="list" aria-label="{{ 'kneetech.assure.payments' | t | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'kt-trust__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endunless -%}
  </div>

  <a class="kt-assure__link" href="{{ link }}">{{ 'kneetech.assure.link' | t }}</a>
</div>
<script>
  (() => {
    const lang = document.documentElement.lang || 'cs';
    const en = lang.toLowerCase().startsWith('en');
    const pad = (n) => String(n).padStart(2, '0');
    const key = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const easter = (y) => {
      const a = y % 19, b = Math.floor(y / 100), c = y % 100, d = Math.floor(b / 4), e = b % 4;
      const f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3);
      const h = (19 * a + b - d - g + 15) % 30, i = Math.floor(c / 4), k = c % 4;
      const l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
      return new Date(y, Math.floor((h + l - 7 * m + 114) / 31) - 1, ((h + l - 7 * m + 114) % 31) + 1);
    };
    const holidays = new Set();
    const addYear = (y) => {
      ['01-01', '05-01', '05-08', '07-05', '07-06', '09-28', '10-28', '11-17', '12-24', '12-25', '12-26'].forEach((md) =>
        holidays.add(`${y}-${md}`)
      );
      const ea = easter(y);
      holidays.add(key(new Date(y, ea.getMonth(), ea.getDate() - 2)));
      holidays.add(key(new Date(y, ea.getMonth(), ea.getDate() + 1)));
    };
    const workday = (d) => d.getDay() !== 0 && d.getDay() !== 6 && !holidays.has(key(d));
    const addDays = (from, n) => {
      const d = new Date(from);
      d.setDate(d.getDate() + n);
      while (!workday(d)) d.setDate(d.getDate() + 1);
      return d;
    };
    const today = (() => {
      try {
        const p = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Prague', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()).split('-');
        return new Date(+p[0], +p[1] - 1, +p[2]);
      } catch (e) {
        const n = new Date();
        return new Date(n.getFullYear(), n.getMonth(), n.getDate());
      }
    })();
    [today.getFullYear(), today.getFullYear() + 1].forEach(addYear);
    const fmt = (d) =>
      d.toLocaleDateString(en ? 'en-GB' : 'cs-CZ', { weekday: 'short', day: 'numeric', month: en ? 'short' : 'numeric' });

    document.querySelectorAll('[data-kt-eta]:not([data-done])').forEach((el) => {
      el.dataset.done = '1';
      const ship = fmt(addDays(today, parseInt(el.dataset.ship, 10) || 4));
      const arrive = fmt(addDays(today, parseInt(el.dataset.delivery, 10) || 14));
      el.querySelector('[data-kt-eta-text]').innerHTML = en
        ? `Order today – ships by <strong>${ship}</strong>, arrives by <strong>${arrive}</strong> at the latest.`
        : `Objednej dnes – odešleme do <strong>${ship}</strong>, doručíme nejpozději <strong>${arrive}</strong>`;
      el.hidden = false;
    });
  })();
</script>
