{%- comment -%}
  Sociální sítě: okénko pro každou síť (TikTok, Instagram, YouTube, Facebook).
  Do okénka jde buď nahrané video (má přednost), nebo odkaz na příspěvek – TikTok video,
  Instagram reel/příspěvek nebo YouTube Shorts se vloží přímo do stránky.
  Odkaz na profil: když ho necháš prázdný, vezme se z Nastavení motivu → Sociální sítě.
{%- endcomment -%}
{{ 'kt-about.css' | asset_url | stylesheet_tag }}
{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-ab kt-social color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="kt-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="kt-lead-text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="kt-social__grid" style="--kt-social-cols: {{ section.blocks.size | at_least: 1 | at_most: 3 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign platform = block.settings.platform
          assign profile = block.settings.profile_url | strip
          assign post = block.settings.post_url | strip
          assign embed_src = ''
          case platform
            when 'tiktok'
              assign platform_name = 'TikTok'
              if profile == blank
                assign profile = settings.social_tiktok_link
              endif
              if post contains '/video/'
                assign post_id = post | split: '/video/' | last | split: '?' | first | split: '/' | first
                assign embed_src = 'https://www.tiktok.com/player/v1/' | append: post_id | append: '?music_info=1&description=0&rel=0'
              endif
            when 'instagram'
              assign platform_name = 'Instagram'
              if profile == blank
                assign profile = settings.social_instagram_link
              endif
              assign ig_kind = ''
              if post contains '/reel/'
                assign ig_kind = 'reel'
              elsif post contains '/p/'
                assign ig_kind = 'p'
              endif
              if ig_kind != ''
                assign ig_sep = '/' | append: ig_kind | append: '/'
                assign post_id = post | split: ig_sep | last | split: '?' | first | split: '/' | first
                assign embed_src = 'https://www.instagram.com/' | append: ig_kind | append: '/' | append: post_id | append: '/embed/'
              endif
            when 'youtube'
              assign platform_name = 'YouTube'
              if profile == blank
                assign profile = settings.social_youtube_link
              endif
              if post contains '/shorts/'
                assign post_id = post | split: '/shorts/' | last | split: '?' | first | split: '/' | first
                assign embed_src = 'https://www.youtube-nocookie.com/embed/' | append: post_id
              endif
            else
              assign platform_name = 'Facebook'
              if profile == blank
                assign profile = settings.social_facebook_link
              endif
          endcase
          assign handle = block.settings.handle | strip
        -%}
        <article class="kt-social-card kt-social-card--{{ platform }} kt-reveal" {{ block.shopify_attributes }}>
          <div class="kt-social-card__top">
            <span class="kt-social-card__logo" aria-hidden="true">
              {%- case platform -%}
                {%- when 'tiktok' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.790.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
                {%- when 'instagram' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
                {%- when 'youtube' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 15.5v-7l6 3.5-6 3.5z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14.5 8H16V5.2c-.3 0-1.2-.2-2.3-.2-2.3 0-3.7 1.4-3.7 4v2.3H7.5v3.1H10V22h3v-7.6h2.5l.4-3.1H13V9.3c0-.9.3-1.3 1.5-1.3z"/></svg>
              {%- endcase -%}
            </span>
            <div class="kt-social-card__who">
              <span class="kt-social-card__platform">{{ platform_name }}</span>
              {%- if handle != blank -%}
                <span class="kt-social-card__handle">{{ handle }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.video != blank -%}
            <div class="kt-social-card__media">
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  playsinline: true,
                  controls: false,
                  preload: 'metadata',
                  image_size: '640x'
              }}
            </div>
          {%- elsif embed_src != '' -%}
            <div class="kt-social-card__media kt-social-card__media--embed">
              <iframe
                src="{{ embed_src }}"
                title="{{ platform_name }} – {{ handle | default: shop.name | escape }}"
                loading="lazy"
                allow="encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          {%- else -%}
            <div class="kt-social-card__media">
              <div class="kt-social-card__empty">
                <span class="kt-social-card__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12-7.5-12-7.5z"/></svg>
                </span>
                <p>{{ section.settings.empty_text }}</p>
                {%- if request.design_mode -%}
                  <p class="kt-social-card__editor">Vlož video nebo odkaz na příspěvek v nastavení tohoto okénka.</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <div class="kt-social-card__bottom">
            {%- if block.settings.caption != blank -%}
              <p class="kt-social-card__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
            {%- if profile != blank -%}
              <a class="kt-social-card__follow" href="{{ profile | escape }}" target="_blank" rel="noopener">
                {{- block.settings.follow_label | default: section.settings.follow_label -}}
                {%- render 'kt-icon', name: 'arrow' -%}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Sociální sítě",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "Sociální sítě" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Sleduj nás" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "follow_label", "label": "Text tlačítka na profil", "default": "Sledovat" },
    { "type": "text", "id": "empty_text", "label": "Text v prázdném okénku", "default": "Video brzy. Mezitím nás sleduj." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "network",
      "name": "Síť",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Síť",
          "default": "tiktok",
          "options": [
            { "value": "tiktok", "label": "TikTok" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "facebook", "label": "Facebook" }
          ]
        },
        { "type": "text", "id": "handle", "label": "Jméno účtu", "placeholder": "@kneetech" },
        { "type": "url", "id": "profile_url", "label": "Odkaz na profil", "info": "Prázdné = odkaz z Nastavení motivu → Sociální sítě." },
        { "type": "video", "id": "video", "label": "Nahrané video (na výšku)", "info": "Má přednost před odkazem na příspěvek." },
        { "type": "text", "id": "post_url", "label": "Nebo odkaz na příspěvek", "info": "TikTok video, Instagram reel/příspěvek nebo YouTube Shorts – vloží se přímo do okénka." },
        { "type": "text", "id": "caption", "label": "Popisek (nepovinné)" },
        { "type": "text", "id": "follow_label", "label": "Text tlačítka (nepovinné)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KT – Sociální sítě",
      "blocks": [
        { "type": "network", "settings": { "platform": "tiktok" } },
        { "type": "network", "settings": { "platform": "instagram" } }
      ]
    }
  ]
}
{% endschema %}
