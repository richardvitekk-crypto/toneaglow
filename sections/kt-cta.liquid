{%- render 'kt-section-padding', section: section -%}

{%- liquid
  assign cta_link = section.settings.button_link
  if cta_link == blank and section.settings.product != blank
    assign cta_link = section.settings.product.url
  endif
-%}

<div class="kt-section kt-cta color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-cta__box kt-reveal">
      <div>
        <h2 class="kt-heading kt-heading--md">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div>{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank and cta_link != blank -%}
        <a href="{{ cta_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Výzva k nákupu",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Připraven na další trénink?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>1 kus za 590 Kč, 2 kusy za 790 Kč.</p>" },
    { "type": "text", "id": "button_label", "label": "Tlačítko – text", "default": "Chci bandáž" },
    { "type": "url", "id": "button_link", "label": "Tlačítko – odkaz", "info": "Když necháš prázdné, vede na vybraný produkt." },
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "presets": [{ "name": "KT – Výzva k nákupu" }]
}
{% endschema %}
