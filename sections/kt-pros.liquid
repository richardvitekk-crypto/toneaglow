{%- comment -%}
  Testováno profíky: výzva „Chceš být úspěšný jako oni?“ s odkazem na recenze hráčů
  (karusel #recenze-z-terenu na hlavní stránce).
{%- endcomment -%}
{{ 'kt-about.css' | asset_url | stylesheet_tag }}
{%- render 'kt-section-padding', section: section -%}

{%- liquid
  assign pros_link = section.settings.button_link | strip
  if pros_link == blank
    assign pros_link = routes.root_url | append: '#recenze-z-terenu' | replace: '//#', '/#'
  elsif pros_link contains '#' and pros_link.size > 1
    assign first_char = pros_link | slice: 0
    if first_char == '#'
      assign pros_link = routes.root_url | append: pros_link | replace: '//#', '/#'
    endif
  endif
-%}

<div class="kt-section kt-ab kt-pros color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kt-pros__box kt-reveal">
      <div>
        {%- if section.settings.badge != blank -%}
          <span class="kt-pros__badge">
            {%- render 'kt-icon', name: 'trophy' -%}
            {{ section.settings.badge }}
          </span>
        {%- endif -%}
        <h2 class="kt-heading kt-pros__title">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_accent != blank -%}
            {{ ' ' }}<em>{{ section.settings.heading_accent }}</em>
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="kt-pros__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <div class="kt-pros__ask">
        <p class="kt-pros__question">{{ section.settings.question }}</p>
        {%- if section.settings.button_label != blank -%}
          <a class="kt-pros__btn" href="{{ pros_link | escape }}">
            {{- section.settings.button_label -}}
            {%- render 'kt-icon', name: 'arrow' -%}
          </a>
        {%- endif -%}
        {%- if section.settings.fine != blank -%}
          <p class="kt-pros__fine">{{ section.settings.fine }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "KT – Testováno profíky",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Odznak", "default": "Testováno profíky" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Nosí ji hráči a hráčky" },
    { "type": "text", "id": "heading_accent", "label": "Nadpis – zvýrazněná část", "default": "z profesionálních akademií." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "question", "label": "Otázka", "default": "Chceš být úspěšný jako oni?" },
    { "type": "text", "id": "button_label", "label": "Tlačítko – text", "default": "Podívej se, kdo ji nosí" },
    { "type": "text", "id": "button_link", "label": "Tlačítko – odkaz", "info": "Prázdné = recenze hráčů na hlavní stránce (#recenze-z-terenu)." },
    { "type": "text", "id": "fine", "label": "Drobný text pod tlačítkem (nepovinné)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 72 }
  ],
  "presets": [{ "name": "KT – Testováno profíky" }]
}
{% endschema %}
