{%- comment -%}
  O nás – úvod stránky: velký nadpis, krátký příběh a 4 karty „na čem si zakládáme“.
{%- endcomment -%}
{{ 'kt-about.css' | asset_url | stylesheet_tag }}
{%- render 'kt-section-padding', section: section -%}

<div class="kt-section kt-ab kt-ab-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="kt-ab__pitch" aria-hidden="true"></div>
  <div class="page-width kt-ab__inner section-{{ section.id }}-padding">
    <div class="kt-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="kt-heading kt-ab-hero__title">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_accent != blank -%}
          {{ ' ' }}<em>{{ section.settings.heading_accent }}</em>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="kt-ab-hero__lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="kt-ab-pillars" role="list">
        {%- for block in section.blocks -%}
          <li class="kt-ab-pillar kt-reveal" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              {%- render 'kt-icon', name: block.settings.icon, class: 'kt-ab-pillar__icon' -%}
            {%- endif -%}
            <span class="kt-ab-pillar__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "KT – O nás úvod",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Malý nadpis", "default": "O nás" },
    { "type": "text", "id": "heading", "label": "Nadpis", "default": "Postaveno na hřišti." },
    { "type": "text", "id": "heading_accent", "label": "Nadpis – zvýrazněná část", "default": "Pro každý sport." },
    { "type": "richtext", "id": "text", "label": "Krátký příběh" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Karta",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikona",
          "default": "none",
          "options": [
            { "value": "none", "label": "Žádná" },
            { "value": "ball", "label": "Míč" },
            { "value": "trophy", "label": "Pohár" },
            { "value": "shield", "label": "Štít" },
            { "value": "check", "label": "Fajfka" },
            { "value": "knee", "label": "Koleno" },
            { "value": "chat", "label": "Zpráva" },
            { "value": "return-circle", "label": "Vrácení" }
          ]
        },
        { "type": "text", "id": "title", "label": "Nadpis", "default": "Ověřeno na trávě" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "KT – O nás úvod" }]
}
{% endschema %}
